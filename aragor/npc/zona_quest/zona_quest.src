//// Asistente del Mercado ////
quiz_02,147,373,5	script	Harold	4_M_PRESIDENT,{

	set @npcname$,"[^8000FFHarold^000000]";
	set @cantidad,0;

	cutin "lhz_karl",2;
	mes @npcname$;
	mes (Sex?"Bienvenido":"Bienvenida")+" al mercado "+(Sex?"chico":"chica")+",";
	mes "soy ^8000FFHarold^000000 y soy el encargado oficial de las divisas.";
	mes "Puedo cambiar Bolsas de Zeny x Zeny y viceversa tambien";
	mes "Puedo cambiar tus ^F79F81Poring Coin^000000 (^F79F81PC^000000) por ^04B404Cash Points^000000 (^04B404CP^000000) y viceversa!";
	mes "Y ademas puedo decirte cuantos ^04B404CP^000000 te quedan en tu cuenta!";
	next;
	switch(select("Informacion:^F79F81PC^000000 por ^04B404CP^000000:^04B404CP^000000 por ^F79F81PC^000000:Zeny x Bolsas")) {
		case 1:
			switch(select("Ver mis ^04B404Cash Points^000000:Intercambio de divisas:Zeny x bolsas")) {
				case 1:
					mes @npcname$;
					mes "Actualmente tienes [^04B404"+#CASHPOINTS+"^000000] ^04B404CP^000000.";
					close2;
					cutin "",255;
					end;
				case 2:
					mes @npcname$;
					mes "Actualmente, el precio de mercado de ^F79F81PC^000000 y ^04B404CP^000000 es el mismo, por ejemplo podria hacer que [^F79F8120^000000] ^F79F81PC^000000 pasen a ser [^04B40420^000000] ^04B404CP^000000!";
					close2;
					cutin "",255;
					end;
				case 3:
					mes @npcname$;
					mes "Podrás cambiar la cantidad de:";
					mes "^c50000500,000,000z a bolsa oro.";
					mes "^c50000250,000,000z a bolsa plata.";
					mes "^c50000125,000,000z a bolsa bronze.";
					mes "^c50000100,000,000z a moneda oro.";
					mes "^c5000050,000,000z a moneda plata.";
					mes "^c5000025,000,000z a moneda plata.";
					next;
					mes @npcname$;
					mes "estas bolsas las podras abrir en cualquier momento";
					mes "Se convierten en monedas o en Zeny segun lo requieras";
					next;
					mes "las monedas solo se convertiran en Zeny";
					mes "tendras que venir con migo para hacer bolsas";
					close2;
					cutin "",255;
					end;
			}
			
		case 2:
			mes @npcname$;
			mes "Que cantidad de ^F79F81PC^000000 deseas pasar a ^04B404CP^000000?";
			next;
			input @cantidad;
			mes @npcname$;
			mes "Estas "+(Sex?"seguro":"segura")+" de querer cambiar el total de [^F79F81"+@cantidad+"^000000] ^F79F81PC^000000?";
			next;
			menu "Si",-,"No",L_Cancel;
			if ( countitem(7539) < @cantidad) goto L_NoPC;
			delitem 7539,@cantidad;
			set #CASHPOINTS, #CASHPOINTS + @cantidad;
			mes @npcname$;
			mes "Tus [^F79F81"+@cantidad+"^F79F81] ^F79F81PC^000000 ahora son [^04B404"+@cantidad+"^000000] ^04B404CP^000000!";
			close2;
			cutin "",255;
			end;
			
		case 3:
			mes @npcname$;
			mes "Que cantidad de ^04B404CP^000000 deseas pasar a ^F79F81PC^000000?";
			next;
			input @cantidad;
			mes @npcname$;
			mes "Estas "+(Sex?"seguro":"segura")+" de querer cambiar el total de [^04B404"+@cantidad+"^000000] ^04B404CP^000000?";
			next;
			menu "Si",-,"No",L_Cancel;
			if ( #CASHPOINTS < @cantidad) goto L_NoCP;
			set #CASHPOINTS, #CASHPOINTS - @cantidad;
			getitem 7539,@cantidad;
			mes @npcname$;
			mes "Tus [^04B404"+@cantidad+"^000000] ^04B404CP^000000 ahora son [^F79F81"+@cantidad+"^000000] ^F79F81PC^000000!";
			close2;
			cutin "",255;
			end;
		case 4:
			mes @npcname$;
			switch(select("Zeny a bolsa:Monedas a bolsa:Zeny a moneda:nada")) {
			case 1:
				mes @npcname$;
				switch(select("Oro 500M:Plata 250M:Bronze 125M")) {
					case 1:
						if ( Zeny < 500000000) goto L_NoZn;
						getitem BZC_GOLD,1;set Zeny,Zeny-500000000;
						mes @npcname$;mes "Listo ayi tiene tu bolsa";
						close2;cutin "",255;end;
					case 2:
						if ( Zeny < 250000000) goto L_NoZn;
						getitem BZC_SILVER,1;set Zeny,Zeny-250000000;
						mes @npcname$;mes "Listo ayi tiene tu bolsa";
						close2;cutin "",255;end;
					case 3:
						if ( Zeny < 125000000) goto L_NoZn;
						getitem BZC_BRONZE,1;set Zeny,Zeny-125000000;
						mes @npcname$;mes "Listo ayi tiene tu bolsa";
						close2;cutin "",255;end;
					}
				break;
			case 2:
			mes @npcname$;
			switch(select("Oro 100M:Plata 50M:Bronze 25M")) {
					case 1:
						if ( Zeny < 100000000) goto L_NoZn;
						getitem ZC_GOLD,1;set Zeny,Zeny-100000000;
						mes @npcname$;mes "Listo ayi tiene tu Moneda";
						close2;cutin "",255;end;
					case 2:
						if ( Zeny < 50000000) goto L_NoZn;
						getitem ZC_SILVER,1;set Zeny,Zeny-50000000;
						mes @npcname$;mes "Listo ayi tiene tu Moneda";
						close2;cutin "",255;end;
					case 3:
						if ( Zeny < 25000000) goto L_NoZn;
						getitem ZC_BRONZE,1;set Zeny,Zeny-25000000;
						mes @npcname$;mes "Listo ayi tiene tu Moneda";
						close2;cutin "",255;end;
					}
				break;
			case 3:
				switch(select("Oro 500M:Plata 250M:Bronze 125M")) {
					case 1:
						if ( countitem(ZC_GOLD) < 5) goto L_NOZC;
						delitem ZC_GOLD,5;getitem BC_GOLD,1;
						mes @npcname$;mes "Listo ayi tiene tu bolsa";
						close2;cutin "",255;end;
					case 2:
						if ( countitem(ZC_SILVER) < 5) goto L_NOZC;
						delitem ZC_SILVER,5;getitem BC_SILVER,1;
						mes @npcname$;mes "Listo ayi tiene tu bolsa";
						close2;cutin "",255;end;
					case 3:
						if ( countitem(ZC_BRONZE) < 5) goto L_NOZC;
						delitem ZC_BRONZE,5;getitem BC_BRONZE,1;
						mes @npcname$;mes "Listo ayi tiene tu bolsa";
						close2;cutin "",255;end;
					}
				break;
			case 4:
				goto L_Cancel;
			}
			
			
	}

L_NoPC:
	mes @npcname$;
	mes "Lo siento ^0080FF"+strcharinfo(0)+"^000000, pero te faltan ^F79F81Poring Coins^000000 para realizar la transaccion.";
	close2;
	cutin "",255;
	end;
	
L_NoCP:
	mes @npcname$;
	mes "Lo siento ^0080FF"+strcharinfo(0)+"^000000, pero te faltan ^04B404Cash Points^000000 para realizar la transaccion.";
	close2;
	cutin "",255;
	end;

L_NoZn:
	mes @npcname$;
	mes "Lo siento ^0080FF"+strcharinfo(0)+"^000000, pero te falta ^04B404Zeny^000000 para realizar la transaccion.";
	close2;
	cutin "",255;
	end;
	
L_NOZC:
	mes @npcname$;
	mes "Lo siento ^0080FF"+strcharinfo(0)+"^000000, pero te faltan ^04B404Monedass^000000 para realizar la transaccion.";
	close2;
	cutin "",255;
	end;

L_Cancel:
	mes @npcname$;
	mes "Como usted desee, que pase un buen dia!";
	close2;
	cutin "",255;
	end;
		
OnInit:
	waitingroom "Asistente del Mercado",0;
	end;
}