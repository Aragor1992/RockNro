	case 1:
	callfunc "ashop",7;
	close;
	case 2:
	callfunc "wshop",22; 
	close;
	}
}
//==================================builds======================================

quiz_02,134,393,5	script	Build Espadas#1	4_M_CRU_HEAD,{
if(BaseJob == Job_Crusader){
if(isequipped(Q_1HSword_Poison)||isequipped(Q_1HSword_Neutral)||isequipped(Q_1HSword_Fire)||isequipped(Q_1HSword_Water)||isequipped(Q_1HSword_Wind)||isequipped(Q_1HSword_Earth)||isequipped(Q_1HSword_Holy)||isequipped(Q_1HSword_Dark)||isequipped(Q_1HSword_Ghost)||isequipped(Q_1HSword_Undead)){
mes"Elije entre magico y fisico";
next;
switch(select("Build Magica:Build Fisica")) {
	case 1:
		set palamagico,1; set palafisico,0;
		message strcharinfo(PC_NAME),"Build Magica!!";
		close;
	case 2:
		set palamagico,0; set palafisico,1;
		message strcharinfo(PC_NAME),"Build Fisica!!";
		close;
		}
	}
else
mes"ponte una espada y elije tu build";
close;
}
else
mes"No eres Crusader!! ni Paladin!!";
close;
}

quiz_02,167,393,4	script	Build Taekwon	4_M_CHNOLD,{

if(BaseJob == Job_Taekwon){

if(isequipped(Q_Taekwon_Neutral)|| isequipped(Q_Taekwon_Water)
|| isequipped(Q_Taekwon_Earth)|| isequipped(Q_Taekwon_Fire)
|| isequipped(Q_Taekwon_Wind)|| isequipped(Q_Taekwon_Poison)
|| isequipped(Q_Taekwon_Holy)|| isequipped(Q_Taekwon_Dark)
|| isequipped(Q_Taekwon_Ghost)|| isequipped(Q_Taekwon_Undead)){
mes"Elije entre magico y fisico";
switch(select("Build Magica:Build Fisica:Resetear Build")) {
	case 1:
		set taekmagico,1; set taekfisico,0;
		message strcharinfo(PC_NAME),"Build Magica!!";
		close;
	case 2:
		set taekmagico,0; set taekfisico,1;
		message strcharinfo(PC_NAME),"Build Fisica!!";
	case 3:
		set taekmagico,0; set taekfisico,0;
		message strcharinfo(PC_NAME),"Reseteado!!";
	close;
	}
} 
else
mes"ponte un Arma Taekwon y elije tu build";
close;
} else if(BaseJob == Job_Star_Gladiator){mes"Ya eres Star Gladiator! ya no puedo afinar tu arma";close;}
else
mes"No eres Taekwon!!";
close;
}

quiz_02,173,391,4	script	Build Shurikens	4_M_KAGE_OLD,{
if(BaseJob == Job_Ninja){
	if(isequipped(Q_HUUMA_Neutral)|| isequipped(Q_HUUMA_Water)
		|| isequipped(Q_HUUMA_Earth)|| isequipped(Q_HUUMA_Fire)
		|| isequipped(Q_HUUMA_Wind)|| isequipped(Q_HUUMA_Poison)
		|| isequipped(Q_HUUMA_Holy)|| isequipped(Q_HUUMA_Dark)
		|| isequipped(Q_HUUMA_Ghost)|| isequipped(Q_HUUMA_Undead)){
			mes"Elije entre magico y fisico";
			switch(select("Build Magica:Build Fisica:Resetear Build")) {
				case 1:
					set ninjamagico,1; set ninjafisico,0;
					message strcharinfo(PC_NAME),"Build Magica!!";
					close;
				case 2:
					set ninjaico,0; set ninjafisico,1;
					message strcharinfo(PC_NAME),"Build Fisica!!";
				case 3:
					set ninjamagico,0; set ninjafisico,0;
					message strcharinfo(PC_NAME),"Reseteado!!";
				close;
				}
	}else mes"ponte un Arma Taekwon y elije tu build";close;
}else mes"no eres ninja";close;
}

