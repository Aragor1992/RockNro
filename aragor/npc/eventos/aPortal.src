	sleep 30000;
	announce "Run Or Die!!!: Ultimos 30 segundos.",bc_npc,0x00ffff;
	sleep 20000;
	announce "Run Or Die!!!: Últimos 10 segundos para unirse. el portal que esta al norte de la plaza de prontera se cerrara.",bc_npc,0x00ffff;
	sleep 5000;
	announce "Run Or Die: 5", bc_all;
	sleep 1000;
