OnPorkill:
announce "Poring: El portal para el evento de los Poring falsos ha sido cerrado.",bc_npc,0x00ffff;
hideonnpc "aPortal";
set $ap,0;
end;

OnEmpBreak:
	if(agitcheck() && agitcheck2()) end;
	set $ap,5;
	killmonsterall "pvp_n_2-5";
	hideoffnpc "aPortal";
	announce "Empe Break: El evento Emperium Break a comenzado.",bc_npc,0x00ffff;
	sleep 1000;
	announce "Empe Break: Entren por el portal que esta al norte de la plaza de prontera.",bc_npc,0x00ffff;
	donpcevent "aBreakemp::OnBreakemp";
	end;

OnEmpclose:
	set $ap,0;
	killmonsterall "pvp_n_2-5";
	hideonnpc "aPortal";
	end;
	
OnAquaDemons:
	if(agitcheck() && agitcheck2()) end;
	killmonsterall "amatsu";
	announce "Lluvia torrenciales arrasan la ciudad de Amatsu.",bc_npc,0x00ffff;
	sleep 25000;
	announce "Los cinco demonios del Aqua han escapado misteriosamente de su prisión en las mazmorras del Castillo.",bc_npc,0x00ffff;
	sleep 30000;
	announce "La ciudad es ahora un caos de infinitas burbujas azules que lo arrasan todo.",bc_npc,0x00ffff;
	sleep 30000;
	announce "El Señor de Amatsu ofrece una gran recompensa por cada una de las perturbadas almas de los demonios del Aqua.",bc_npc,0x00ffff;
	sleep 20000;
	announce "La vida de la ciudad de Amatsu está colgando de un hilo. Si nadie hace nada, pronto desaparecerá de los mapas.",bc_npc,0x00ffff;
	sleep 5000;
	donpcevent "Aqua_demons::OnAquademonstart";
	end;
	
OnSpawnMorocc:
	donpcevent "Satan_invacion::OnSpawnMorocc";
	end;

OnRunorDie:
	if(agitcheck() && agitcheck2()) end;
	set $ap,9;
	killmonsterall "guild_vs5";
	hideoffnpc "aPortal";
	announce "Run Or Die!!!: ¿Estás listo para unirte al evento Run Or Die?.",bc_npc,0x00ffff;
