function	script	F_Fallen	{
    set .@c,callfunc("contar_cartas",EQI_HAND_L,4441);
    set .@d,callfunc("contar_cartas",EQI_HAND_R,4441);
    if(.@c == 1 && .@d == 1 || .@c == 1 && .@d == 0 || .@c == 0 && .@d == 1){
        bonus2 bMagicAddRace,RC_DemiHuman,30;
    }
    return;
}

function	script	F_Ifrit	{
    set .@c,callfunc("contar_cartas",EQI_ACC_L,4430);
    set .@d,callfunc("contar_cartas",EQI_ACC_R,4430);
    if(.@c == 1 && .@d == 1 || .@c == 1 && .@d == 0 || .@c == 0 && .@d == 1){
		bonus bBaseAtk,(JobLevel/2);		
		bonus bHit,(JobLevel/2);
		bonus bCritical,(JobLevel/4);
    }
    return;
}

