// =================== CHINESE HELM =================
function	script	P_ChineseHelm	{
	bonus bUnstripableHelm,0;
	bonus bMaxHPrate,20;
	bonus bAgi,10;
	bonus bVit,10;
	bonus bLuk,10;
	if(isequipped(P_Ikki_Wings)||isequipped(P_ArchAngel_wings)) {
		bonus bLongWeaponDamageReturn,-10;
	}
	bonus bLongWeaponDamageReturn,20;
return;
}
// =================== Dragon Helm ===================
function	script	P_DragonHelm	{
	bonus bUnstripableHelm,0;
	bonus bAgi,10;
	bonus bVit,10;
	bonus bDex,10;	
	bonus bHit,100;
	bonus bPerfectHitRate,10;
	bonus bAspdRate,10;
	bonus bMaxHPrate,20;
	if(isequipped(P_red_fallenW) || isequipped(P_Pink_FallenW)) {
		bonus bHit,50;
		bonus bAtkRate,5;
	}
return;
}
// =================== Ice Wolf Hat ==================
function	script	P_IceWolfHat	{
	if(isequipped(P_artic_wings)) {
		bonus bUnstripableHelm,0;
		bonus2 bSubEle,Ele_Water,20;
		bonus4 bAutoSpellWhenHit, NPC_ICEBREATH, 5, 100, 1;
	}
	bonus bInt,10;
	bonus bDex,10;
	bonus bVit,10;
	bonus bMaxHPrate,20;
	bonus bMatkRate,10;
	bonus4 bAutoSpellWhenHit,89,5,50,0;
	bonus2 bSubEle,Ele_Water,10;
	bonus2 bSPRegenRate,10,1000;
return;
}
