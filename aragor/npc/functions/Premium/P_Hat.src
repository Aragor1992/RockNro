// =================== Penacho de Moktezuma ==================
function	script	P_PMoktezuma	{
	if(Class==Job_Paladin||Class==Job_Crusader) {
		bonus bShortWeaponDamageReturn,-10;
	}
	bonus bShortWeaponDamageReturn,20;
	bonus bStr,10;
	bonus bDex,10;
	bonus bVit,10;
	bonus bMaxHPrate,30;
	bonus bAtkRate,5;
	bonus bUnstripableHelm,0;
return;
}
// =================== Archangel Helm ==================
function	script	P_ArchangelHelm	{
	bonus bUnstripableHelm,0;
	bonus bInt,10;
	bonus bDex,10;
	bonus bVit,10;
	bonus bMaxHPrate,20;
	bonus bMatkRate,10;
	if(isequipped(P_Heart_Wings)) {
		bonus3 bMagicDamageReturn2,100,1,-10;
		bonus3 bMagicDamageReturn2,100,0,-10;
	}
	bonus3 bMagicDamageReturn2,100,1,20;
	bonus3 bMagicDamageReturn2,100,0,20;
return;
}
