function	script	Novice_Manteau	{
switch(Q_Novice_Manteau){
case 1:
if(isequipped(Q_Novice_Shoes,M_ARMOR_Neutral) || isequipped(Q_Novice_Shoes,A_ARMOR_Neutral) || isequipped(Q_Novice_Shoes,P_Armor_Neutral)) {
		bonus2 bSubEle,Ele_Neutral,20;
		bonus bMaxHPrate,10;
		bonus bMaxSPrate,10;
		bonus2 bAddEle,Ele_Neutral,20;
		bonus bHit,70;
		bonus2 bResEff,Eff_Bleeding,10000;
	}else{bonus2 bSubEle,Ele_Neutral,15;}		
break;
	
case 2:
if(isequipped(Q_Novice_Shoes,M_ARMOR_Water) || isequipped(Q_Novice_Shoes,A_ARMOR_Water) || isequipped(Q_Novice_Shoes,P_Armor_Water) ) {
		bonus2 bSubEle,Ele_Water,20;
		bonus bMaxHPrate,10;
		bonus bMaxSPrate,10;
		bonus2 bAddEle,Ele_Water,20;
		bonus2 bHPRegenRate,1000,500;
		bonus2 bSPRegenRate,50,1000;
		bonus2 bResEff,Eff_Sleep,10000;
	}else{bonus2 bSubEle,Ele_Water,15;}		
break;
	
case 3:
if(isequipped(Q_Novice_Shoes,M_ARMOR_Earth) || isequipped(Q_Novice_Shoes,A_ARMOR_Earth) || isequipped(Q_Novice_Shoes,P_Armor_Earth) ) {
		bonus2 bSubEle,Ele_Earth,20;
		bonus bMaxHPrate,10;
		bonus bMaxSPrate,10;
		bonus2 bAddEle,Ele_Earth,20;
		bonus2 bSubSize,1,10;
		bonus2 bSubSize,0,10;
}	else{bonus2 bSubEle,Ele_Earth,15;}
break;
	
case 4:
if(isequipped(Q_Novice_Shoes,M_ARMOR_Fire) || isequipped(Q_Novice_Shoes,A_ARMOR_Fire) || isequipped(Q_Novice_Shoes,P_Armor_Fire) ) {
		bonus2 bSubEle,Ele_Fire,20;
		bonus bMaxHPrate,10;
		bonus bMaxSPrate,10;
		bonus2 bAddEle,Ele_Fire,20;
		bonus2 bAddRace,RC_NonBoss,10;
		bonus2 bAddRace,RC_Boss,10;
		bonus2 bAddRace2,5,10; //guardians
		bonus2 bMagicAddRace,RC_DemiHuman,10;
		bonus2 bResEff,Eff_Stone,10000;
	}else{bonus2 bSubEle,Ele_Fire,15;}
break;
	
case 5:
if(isequipped(Q_Novice_Shoes,M_ARMOR_Wind) || isequipped(Q_Novice_Shoes,A_ARMOR_Wind) || isequipped(Q_Novice_Shoes,P_Armor_Wind) ) {
		bonus2 bSubEle,Ele_Wind,20;
		bonus bMaxHPrate,10;
		bonus bMaxSPrate,10;
		bonus2 bAddEle,Ele_Wind,20;
		bonus bAtkRange,3;
		bonus2 bResEff,Eff_Freeze,10000;
	}else{bonus2 bSubEle,Ele_Wind,15;}
break;
	
case 6:
if(isequipped(Q_Novice_Shoes,M_ARMOR_Poison) || isequipped(Q_Novice_Shoes,A_ARMOR_Poison) || isequipped(Q_Novice_Shoes,P_Armor_Poison) ) {
		bonus2 bSubEle,Ele_Poison,20;
		bonus bMaxHPrate,10;
		bonus bMaxSPrate,10;
		bonus2 bAddEle,Ele_Poison,20;
		bonus bCritical,10;
		bonus bCritAtkRate,10;
		bonus2 bResEff,Eff_Stone,10000;
	}else{bonus2 bSubEle,Ele_Poison,15;}
break;
	
case 7:
bonus2 bSubEle,Ele_Holy,15;
break;
	
case 8:
if(isequipped(Q_Novice_Shoes,M_ARMOR_Dark) || isequipped(Q_Novice_Shoes,A_ARMOR_Dark) || isequipped(Q_Novice_Shoes,P_Armor_Dark) ) {
		bonus2 bSubEle,Ele_Dark,20;
		bonus bMaxHPrate,10;
		bonus bMaxSPrate,10;
		bonus2 bAddEle,Ele_Dark,20;
		bonus2 bAddEle,Ele_Holy,15;
		bonus bSplashAddRange,2;
	}else{bonus2 bSubEle,Ele_Dark,15;}
break;
	
case 9:
if(isequipped(Q_Novice_Shoes,M_ARMOR_Ghost) || isequipped(Q_Novice_Shoes,A_ARMOR_Ghost) || isequipped(Q_Novice_Shoes,P_Armor_Ghost) ) {
		bonus2 bSubEle,Ele_Ghost,20;
		bonus bMaxHPrate,10;
		bonus bMaxSPrate,10;
		bonus2 bAddEle,Ele_Ghost,20;
		bonus2 bSPVanishRate,50,10;
		bonus2 bSPRegenRate,20,1000;
		bonus2 bResEff,Eff_Sleep,10000;
	}else{bonus2 bSubEle,Ele_Ghost,15;}
break;
	
case 10:
if(isequipped(Q_Novice_Shoes,M_ARMOR_Undead) || isequipped(Q_Novice_Shoes,A_ARMOR_Undead) || isequipped(Q_Novice_Shoes,P_Armor_Undead) ) {
		bonus2 bSubEle,Ele_Undead,20;
		bonus bMaxHPrate,10;
		bonus bMaxSPrate,10;
		bonus2 bAddEle,Ele_Undead,20;
		bonus2 bHPDrainRate,200,5;
		bonus2 bResEff,Eff_Stone,10000;
	}else{bonus2 bSubEle,Ele_Undead,15;}
break;
}
return;
}