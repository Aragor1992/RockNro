function	script	F_Naruto_Uno	{

switch(getarg(0)+1){
case 1:	bonus2 bSubEle,Ele_Neutral,5; bonus bAllStats,3;
	if(isequipped(Q_Garment_Neutral,Q_SHOES_Neutral,P_Armor_Neutral)	|| isequipped(Q_Garment_Neutral,Q_SHOES_Neutral,M_ARMOR_Neutral)	|| isequipped(Q_Garment_Neutral,Q_SHOES_Neutral,A_ARMOR_Neutral) )	{
		bonus bAllStats,7;
	}	break;

case 2:	bonus2 bSubEle,Ele_Water,5;	bonus bAllStats,3;
	if(isequipped(Q_SHOES_Water,Q_Garment_Water,M_ARMOR_Water)	|| isequipped(Q_SHOES_Water,Q_Garment_Water,A_ARMOR_Water)	|| isequipped(Q_SHOES_Water,Q_Garment_Water,P_Armor_Water) )	{
		bonus bAllStats,7;
	}	break;

case 3:	bonus2 bSubEle,Ele_Earth,5; bonus bAllStats,3;
	if(isequipped(Q_SHOES_Earth,Q_Garment_Earth,M_ARMOR_Earth)	|| isequipped(Q_SHOES_Earth,Q_Garment_Earth,A_ARMOR_Earth)	|| isequipped(Q_SHOES_Earth,Q_Garment_Earth,P_Armor_Earth) )	{
		bonus bAllStats,7;
	}	break;

case 4:	bonus2 bSubEle,Ele_Fire,5; bonus bAllStats,3;
	if(isequipped(Q_SHOES_Fire,Q_Garment_Fire,M_ARMOR_Fire)	|| isequipped(Q_SHOES_Fire,Q_Garment_Fire,A_ARMOR_Fire)	|| isequipped(Q_SHOES_Fire,Q_Garment_Fire,P_Armor_Fire) )	{
		bonus bAllStats,7;
		bonus2 bSubEle,Ele_Fire,5;
	} break;

case 5:	bonus2 bSubEle,Ele_Wind,5; bonus bAllStats,3;
	if(isequipped(Q_SHOES_Wind,Q_Garment_Wind,M_ARMOR_Wind)	|| isequipped(Q_SHOES_Wind,Q_Garment_Wind,A_ARMOR_Wind)	|| isequipped(Q_SHOES_Wind,Q_Garment_Wind,P_Armor_Wind) )	{
		bonus bAllStats,7;
	}	break;

case 6:	bonus2 bSubEle,Ele_Poison,5; bonus bAllStats,3;
	if(isequipped(Q_SHOES_Poison,Q_Garment_Poison,M_ARMOR_Poison)	|| isequipped(Q_SHOES_Poison,Q_Garment_Poison,A_ARMOR_Poison)	|| isequipped(Q_SHOES_Poison,Q_Garment_Poison,P_Armor_Poison) )	{		
		bonus bAllStats,7;
	}	break;

case 7:	bonus2 bSubEle,Ele_Holy,5; bonus bAllStats,3;
	if(isequipped(Q_SHOES_Holy,Q_Garment_Holy,M_ARMOR_Holy)	|| isequipped(Q_SHOES_Holy,Q_Garment_Holy,A_ARMOR_Holy)	|| isequipped(Q_SHOES_Holy,Q_Garment_Holy,P_Armor_Holy) )	{		
		bonus bAllStats,7;
	}	break;

case 8:	bonus2 bSubEle,Ele_Dark,5; bonus bAllStats,3;
	if(isequipped(Q_SHOES_Dark,Q_Garment_Dark,M_ARMOR_Dark)	|| isequipped(Q_SHOES_Dark,Q_Garment_Dark,A_ARMOR_Dark)	|| isequipped(Q_SHOES_Dark,Q_Garment_Dark,P_Armor_Dark) )	{		
		bonus bAllStats,7;
	}	break;

case 9:	bonus2 bSubEle,Ele_Ghost,5; bonus bAllStats,3;
	if(isequipped(Q_SHOES_Ghost,Q_Garment_Ghost,M_ARMOR_Ghost)	|| isequipped(Q_SHOES_Ghost,Q_Garment_Ghost,A_ARMOR_Ghost)	|| isequipped(Q_SHOES_Ghost,Q_Garment_Ghost,P_Armor_Ghost) )	{		
		bonus bAllStats,7;
	}	break;

case 10:	bonus2 bSubEle,Ele_Undead,5;bonus bAllStats,3;
	if(isequipped(Q_SHOES_Undead,Q_Garment_Undead,M_ARMOR_Undead)	|| isequipped(Q_SHOES_Undead,Q_Garment_Undead,A_ARMOR_Undead)	|| isequipped(Q_SHOES_Undead,Q_Garment_Undead,P_Armor_Undead) )	{			
			bonus bAllStats,7;
			}	break;

case 11:	bonus2 bSubEle,Ele_Neutral,5;
			bonus bAllStats,5;
			skill CH_PALMSTRIKE,3;
			skill MO_EXPLOSIONSPIRITS,3;
			bonus4 bAutoSpell,CH_SOULCOLLECT,1,250,0;
			if(Class==Job_Assassin||Class==Job_Assassin_Cross) bonus4 bAutoSpell,CH_SOULCOLLECT,1,50,0;
			if(Class==Job_Monk||Class==Job_Champion) bonus4 bAutoSpell,CH_SOULCOLLECT,1,10,0;
break;

case 12:	skill "AL_HEAL",6;
