/*QUEST ACCESORY*/
function	script	S_Critical_Ring	{
	bonus bCritical,10;
	bonus bCritAtkRate,10;
	bonus bAgi,10;
	bonus bLuk,10;
	if(isequipped(18204) || isequipped(18210) || isequipped(18211) || isequipped(18212) || isequipped(18208)){
		bonus bCritical,10;
		bonus bCritAtkRate,10;
		bonus bAgi,10;
		bonus bLuk,10;
	}
return;
}

function	script	S_Bow_Thimble	{
if(Class==3||Class==11||Class==4012||Class==17||Class==4018) {
	bonus bLongAtkRate,10;
	bonus bHit,50;
}
if(isequipped(18204) || isequipped(18210) || isequipped(18211)|| isequipped(18208)){
	if(Class==3||Class==11||Class==4012||Class==17||Class==4018) {
		bonus bLongAtkRate,10;
		bonus bHit,50;
	}
}
return;
}

