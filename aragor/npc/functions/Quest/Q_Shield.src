function	script	S_Mirror_Shield	{
if(Class==Job_Crusader||Class==Job_Paladin||Class==Job_Crusader2||Class==Job_Paladin2) {
	bonus2 bSkillAtk,CR_SHIELDBOOMERANG,70;
	if(isequipped(Swordman_Spirit)|| isequipped(Spirit_Of_Spirits)){
		bonus bMaxHPrate,10;
		bonus bDelayrate,-10;
		if(readparam(bStr)>=150){bonus2 bAddRace,RC_DemiHuman,10;bonus bHit,50;}
		if(readparam(bInt)>=150){bonus bMatkRate,20;}
	}
}
bonus bShortWeaponDamageReturn,10;
bonus bLongWeaponDamageReturn,10;
bonus3 bMagicDamageReturn2,100,1,10;
bonus3 bMagicDamageReturn2,100,0,10;
return;
}

function	script	S_Holy_Guard	{
if(Class==Job_Crusader||Class==Job_Paladin||Class==Job_Crusader2||Class==Job_Paladin2) {
			bonus2 bSkillAtk,CR_SHIELDBOOMERANG,70;
			if(isequipped(Swordman_Spirit)|| isequipped(Spirit_Of_Spirits)){
				bonus bMaxHPrate,10;
				bonus bDelayrate,-10;
				if(readparam(bStr)>=150){
					bonus2 bAddRace,RC_DemiHuman,10;
					bonus bHit,50;
				}
				if(readparam(bInt)>=150){
					bonus bMatkRate,20;
				}
			}
		}
		bonus bAllStats,10;
		bonus2 bSubSize,1,10;
		bonus2 bSubSize,0,10;
		bonus5 bAutoSpellWhenHit,LK_PARRYING,3,20,BF_MAGIC+BF_SHORT+BF_LONG+BF_WEAPON,0;
return;
}
		
