				bonus bDelayrate,-10;
				if(readparam(bStr)>=150){
					bonus2 bAddRace,RC_DemiHuman,10;
					bonus bHit,50;
				}
				if(readparam(bInt)>=150){
					bonus bMatkRate,20;
				}
			}
		}
		bonus bNearAtkDef,50;
		bonus bLongAtkDef,50;
		bonus bMagicAtkDef,50;
		bonus bMatkRate,30;
		bonus bAtkRate,30;
		bonus5 bAutoSpellWhenHit,SA_COMA,1,25,BF_MAGIC+BF_MISC+BF_WEAPON,0;
		/*bonus5 bAutoSpellWhenHit,SA_COMA,1,20,BF_SHORT+BF_LONG+BF_WEAPON,0;
		bonus5 bAutoSpellWhenHit,SA_COMA,1,50,BF_MAGIC,1;
		bonus5 bAutoSpellWhenHit,SA_COMA,1,10,BF_MISC,1;
		*/ bonus bFlee,-100;
		bonus bFlee2,-20;
return;
}