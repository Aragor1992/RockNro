function	script	S_Ahura_Mazdah	{
if(Class==Job_Crusader||Class==Job_Paladin||Class==Job_Crusader2||Class==Job_Paladin2) {
			bonus2 bSkillAtk,CR_SHIELDBOOMERANG,70;
