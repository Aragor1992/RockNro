// =================== Tipo Penacho de Moktezuma ==================
function	script	Q_PMoktezuma	{
	if(Class==Job_Paladin||Class==Job_Crusader) {
		bonus bShortWeaponDamageReturn,5;
	}
	else {
		bonus bShortWeaponDamageReturn,10;
	}
	bonus bStr,5;
	bonus bDex,5;
	bonus bVit,5;
	bonus bMaxHPrate,20;
}
// =================== Fox hat ==================
function	script	Q_fox	{
	bonus bAgi,10;
	bonus bMaxHPrate,10;
	bonus bSpeedRate,5;
	bonus bFlee,20;
	if(isequipped(Fox_tailW)) {
		bonus bFlee,140;
	}
}
