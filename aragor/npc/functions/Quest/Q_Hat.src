// =================== Tipo Black Helm  ATK HAT====================
function	script	Q_BlackHelm	{
	bonus bAgi,5;
	bonus bVit,5;
	bonus bStr,5;
	bonus bMaxHPrate,20;
	bonus bAtkRate,5;
return;
}
