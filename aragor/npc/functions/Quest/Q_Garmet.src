function	script	Q_Garmet	{
bonus bMdef,getrefine();
switch(getarg(0)+1){
case 1:	bonus2 bSubEle,Ele_Neutral,15;
		if(isequipped(Q_Shoes_Neutral) && (isequipped(P_Armor_Neutral) || isequipped(M_Armor_Neutral)|| isequipped(A_Armor_Neutral))) {
		bonus bHit,70;
		bonus bMaxHPrate,10;
		bonus bMaxSPrate,10;
		bonus2 bAddEle,Ele_Neutral,20;
		bonus2 bResEff,Eff_Bleeding,10000;
		}	break;

case 2:	bonus2 bSubEle,Ele_Water,15;
		if(isequipped(Q_Shoes_Water) && (isequipped(P_Armor_Water) || isequipped(M_Armor_Water)|| isequipped(A_Armor_Water))) {
		bonus bMaxHPrate,10;
		bonus bMaxSPrate,10;
		bonus2 bHPRegenRate,1000,500;
		bonus2 bSPRegenRate,50,1000;
		bonus2 bAddEle,Ele_Water,20;
		bonus2 bResEff,Eff_Sleep,10000;
		}	break;

case 3:	bonus2 bSubEle,Ele_Earth,15;
		if(isequipped(Q_Shoes_Earth) && (isequipped(P_Armor_Earth) || isequipped(M_Armor_Earth)|| isequipped(A_Armor_Earth))) {
		bonus bMaxHPrate,10;
		bonus bMaxSPrate,10;
		bonus2 bSubSize,Size_Small,10;
		bonus2 bSubSize,Size_Medium,10;
		bonus2 bAddEle,Ele_Earth,10;
		bonus2 bResEff,Eff_Poison,10000;
		}	break;

case 4:	bonus2 bSubEle,Ele_Fire,15;
		if(isequipped(Q_Shoes_Fire) && (isequipped(P_Armor_Fire) || isequipped(M_Armor_Fire)|| isequipped(A_Armor_Fire))) {
		bonus bMaxHPrate,10;
		bonus bMaxSPrate,10;
		bonus2 bAddMagicDamageClass,Class_All,10;
		bonus2 bAddRace, RC_All,10;
		bonus2 bMagicAddRace,10,RC_DemiHuman+RC_Player;
		bonus2 bAddEle,Ele_Fire,20;
		bonus2 bResEff,Eff_Stone,10000;
		}	break;

case 5:	bonus2 bSubEle,Ele_Wind,15;
		if(isequipped(Q_Shoes_Wind) && (isequipped(P_Armor_Wind) || isequipped(M_Armor_Wind)|| isequipped(A_Armor_Wind))) {
		bonus bMaxHPrate,10;
		bonus bMaxSPrate,10;
		bonus bAtkRange,3;
		bonus2 bAddEle,Ele_Wind,20;
		bonus2 bResEff,Eff_Freeze,10000;
		}	break;

case 6:	bonus2 bSubEle,Ele_Poison,15;
		if(isequipped(Q_Shoes_Poison) && (isequipped(P_Armor_Poison) || isequipped(M_Armor_Poison)|| isequipped(A_Armor_Poison))) {
		bonus bMaxHPrate,10;
		bonus bMaxSPrate,10;
		bonus bCritical,10;
		bonus bCritAtkRate,10;
		bonus2 bAddEle,Ele_Poison,20;
		bonus2 bResEff,Eff_Stone,10000;
		}	break;

case 7:	bonus2 bSubEle,Ele_Holy,15;
		if(isequipped(Q_Shoes_Holy) && (isequipped(P_Armor_Holy) || isequipped(M_Armor_Holy)|| isequipped(A_Armor_Holy))) {
		bonus bMaxHPrate,5;
		bonus bMaxSPrate,5;
		bonus bHPrecovRate,5;
		bonus bSPrecovRate,5;
		bonus2 bSubEle,Ele_Earth,5;
		bonus2 bSubSize,Size_Small,10;
		bonus2 bSubSize,Size_Medium,10;
		bonus2 bAddEle,Ele_Earth,20;
		bonus2 bResEff,Eff_Poison,10000;
		}	break;

case 8:	bonus2 bSubEle,Ele_Dark,15;
		if(isequipped(Q_Shoes_Dark) && (isequipped(P_Armor_Dark) || isequipped(M_Armor_Dark)|| isequipped(A_Armor_Dark))) {
		bonus bMaxHPrate,10;
		bonus bMaxSPrate,10;
		bonus bSplashRange,2;
		bonus2 bAddEle,Ele_Holy,15;
		bonus2 bAddEle,Ele_Dark,20;
		bonus2 bResEff,Eff_Poison,10000;
		}	break;

case 9:	bonus2 bSubEle,Ele_Ghost,15;
		if(isequipped(Q_Shoes_Ghost) && (isequipped(P_Armor_Ghost) || isequipped(M_Armor_Ghost)|| isequipped(A_Armor_Ghost))) {
		bonus bMaxHPrate,10;
		bonus bMaxSPrate,10;
		bonus2 bHPVanishRate,50,10;
		bonus2 bSPRegenRate,20,1000;
		bonus2 bAddEle,Ele_Ghost,20;
		bonus2 bResEff,Eff_Sleep,10000;
	}	break;

case 10:	bonus2 bSubEle,Ele_Undead,15;
		if(isequipped(Q_Shoes_Undead) && (isequipped(P_Armor_Undead) || isequipped(M_Armor_Undead)|| isequipped(A_Armor_Undead))) {
		bonus bMaxHPrate,10;
		bonus bMaxSPrate,10;
		bonus2 bHPDrainRate,50,20;
		bonus2 bAddEle,Ele_Undead,20;
		bonus2 bResEff,Eff_Stone,10000;
		}	break;

}	return;	
}


