function	script	Q_Garmet	{
bonus bMdef,getrefine();
switch(getarg(0)+1){
case 1:	bonus2 bSubEle,Ele_Neutral,15;
		if(isequipped(Q_SHOES_Neutral,M_ARMOR_Neutral) || isequipped(Q_SHOES_Neutral,A_ARMOR_Neutral)|| isequipped(Q_SHOES_Neutral,P_Armor_Neutral)) {
		bonus bHit,70;
		bonus bMaxHPrate,10;
		bonus bMaxSPrate,10;
		bonus2 bAddEle,Ele_Neutral,20;
		bonus2 bResEff,Eff_Bleeding,10000;
		}	break;

case 2:	bonus2 bSubEle,Ele_Water,15;
		if(isequipped(Q_SHOES_Water,M_ARMOR_Water) || isequipped(Q_SHOES_Water,A_ARMOR_Water) || isequipped(Q_SHOES_Water,P_Armor_Water) ) {
		bonus bMaxHPrate,10;
		bonus bMaxSPrate,10;
		bonus2 bHPRegenRate,1000,500;
		bonus2 bSPRegenRate,50,1000;
		bonus2 bAddEle,Ele_Water,20;
		bonus2 bResEff,Eff_Sleep,10000;
		}	break;

case 3:	bonus2 bSubEle,Ele_Earth,15;
		if(isequipped(Q_SHOES_Earth,M_ARMOR_Earth) || isequipped(Q_SHOES_Earth,A_ARMOR_Earth) || isequipped(Q_SHOES_Earth,P_Armor_Earth) ) {
		bonus bMaxHPrate,10;
		bonus bMaxSPrate,10;
		bonus2 bSubSize,Size_Small,10;
		bonus2 bSubSize,Size_Medium,10;
		bonus2 bAddEle,Ele_Earth,10;
		bonus2 bResEff,Eff_Poison,10000;
		}	break;

case 4:	bonus2 bSubEle,Ele_Fire,15;
		if(isequipped(Q_SHOES_Fire,M_ARMOR_Fire) || isequipped(Q_SHOES_Fire,A_ARMOR_Fire) || isequipped(Q_SHOES_Fire,P_Armor_Fire) ) {
		bonus bMaxHPrate,10;
		bonus bMaxSPrate,10;
		bonus2 bAddMagicDamageClass,Class_All,10;
		bonus2 bAddRace, RC_All,10;
		bonus2 bMagicAddRace,10,RC_DemiHuman+RC_Player;
		bonus2 bAddEle,Ele_Fire,20;
		bonus2 bResEff,Eff_Stone,10000;
		}	break;

case 5:	bonus2 bSubEle,Ele_Wind,15;
		if(isequipped(Q_SHOES_Wind,M_ARMOR_Wind) || isequipped(Q_SHOES_Wind,A_ARMOR_Wind) || isequipped(Q_SHOES_Wind,P_Armor_Wind) ) {
		bonus bMaxHPrate,10;
		bonus bMaxSPrate,10;
		bonus bAtkRange,3;
		bonus2 bAddEle,Ele_Wind,20;
		bonus2 bResEff,Eff_Freeze,10000;
		}	break;

case 6:	bonus2 bSubEle,Ele_Poison,15;
		if(isequipped(Q_SHOES_Poison,M_ARMOR_Poison) || isequipped(Q_SHOES_Poison,A_ARMOR_Poison) || isequipped(Q_SHOES_Poison,P_Armor_Poison) ) {
		bonus bMaxHPrate,10;
		bonus bMaxSPrate,10;
		bonus bCritical,10;
		bonus bCritAtkRate,10;
		bonus2 bAddEle,Ele_Poison,20;
		bonus2 bResEff,Eff_Stone,10000;
		}	break;

case 7:	bonus2 bSubEle,Ele_Holy,15;
		if(isequipped(Q_SHOES_Holy,M_ARMOR_Holy) || isequipped(Q_SHOES_Holy,A_ARMOR_Holy) || isequipped(Q_SHOES_Holy,P_Armor_Holy) ) {
		bonus bMaxHPrate,5;
		bonus bMaxSPrate,5;
		bonus bHPrecovRate,5;
		bonus bSPrecovRate,5;
		bonus2 bSubEle,Ele_Earth,5;
		bonus2 bSubSize,Size_Small,10;
		bonus2 bSubSize,Size_Medium,10;
		bonus2 bAddEle,Ele_Earth,20;
		bonus2 bResEff,Eff_Poison,10000;
		}	break;

case 8:	bonus2 bSubEle,Ele_Dark,15;
		if(isequipped(Q_SHOES_Dark,M_ARMOR_Dark) || isequipped(Q_SHOES_Dark,A_ARMOR_Dark) || isequipped(Q_SHOES_Dark,P_Armor_Dark) ) {
		bonus bMaxHPrate,10;
		bonus bMaxSPrate,10;
		bonus bSplashRange,2;
		bonus2 bAddEle,Ele_Holy,15;
		bonus2 bAddEle,Ele_Dark,20;
		bonus2 bResEff,Eff_Poison,10000;
		}	break;

case 9:	bonus2 bSubEle,Ele_Ghost,15;
		if(isequipped(Q_SHOES_Ghost,M_ARMOR_Ghost) || isequipped(Q_SHOES_Ghost,A_ARMOR_Ghost) || isequipped(Q_SHOES_Ghost,P_Armor_Ghost) ) {
		bonus bMaxHPrate,10;
		bonus bMaxSPrate,10;
		bonus2 bHPVanishRate,50,10;
		bonus2 bSPRegenRate,20,1000;
		bonus2 bAddEle,Ele_Ghost,20;
		bonus2 bResEff,Eff_Sleep,10000;
	}	break;

case 10:	bonus2 bSubEle,Ele_Undead,15;
		if(isequipped(Q_SHOES_Undead,M_ARMOR_Undead) || isequipped(Q_SHOES_Undead,A_ARMOR_Undead) || isequipped(Q_SHOES_Undead,P_Armor_Undead) ) {
		bonus bMaxHPrate,10;
		bonus bMaxSPrate,10;
		bonus2 bHPDrainRate,50,20;
		bonus2 bAddEle,Ele_Undead,20;
		bonus2 bResEff,Eff_Stone,10000;
		}	break;

}	return;	
}


function	script	Q_SkelGarmet	{
	bonus bMdef,getrefine();
	bonus bStr,20;
	bonus bVit,20;
	bonus bDex,20;
	bonus bLuk,20;
	bonus bAgi,20;
}