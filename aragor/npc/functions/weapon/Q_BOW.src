function	script	W_BOW_Luna	{
		bonus2 bSkillAtk,1009,20;
		bonus bUnbreakableWeapon,0;
		bonus bDex,30;
		bonus bAgi,20;
		bonus bVit,10;
		bonus2 bSkillAtk,HT_LANDMINE,100;
		bonus2 bSkillAtk,HT_BLASTMINE,100;
		bonus2 bSkillAtk,HT_CLAYMORETRAP,100;
		bonus2 bSkillAtk,AC_DOUBLE,30;
		bonus2 bSkillAtk,AC_SHOWER,80;
		bonus2 bSkillAtk,AC_CHARGEARROW,100;
		bonus2 bSkillAtk,SN_SHARPSHOOTING,30;
		bonus5 bAutoSpell,382,3,50,BF_MAGIC+BF_SHORT+BF_LONG+BF_WEAPON+BF_MISC,1;
		if(Class==Job_Stalker) {
			bonus bAtkRate,30;
		/*	if(isequipped(Rogue_Spirit)|| isequipped(Spirit_Of_Spirits)){
				bonus bFlee,70;
				bonus bMaxHPrate,10;
				bonus bAgi,readparam(bDex)/5;
			}*/
		}
	/*	if(isequipped(Archer_Spirit)|| isequipped(Spirit_Of_Spirits)){
			bonus bDex,20;
			bonus bLuk,20;
			bonus bMaxHPrate,10;
		}*/
return;
}
