[Unit]
Description=Hercules login server
After=syslog.target network.target mariadb.service

[Service]
WorkingDirectory=/home/aragor/Hercules/
User=aragor
ExecStart=/home/aragor/Hercules/login-server
ExecReload=/bin/kill -HUP $MAINPID
KillMode=process
Restart=on-failure
RestartSec=60s

[Install]
WantedBy=multi-user.target